# Single source of truth del runtime yt-dlp para Android.
# Lo lee `build_ytdlp_runtime.sh`; los consts `YTDLP_RUNTIME_*` de
# `rust/src/api/engine_api.rs` deben coincidir (el CI lo comprueba
# comparando `--version` del zip contra YTDLP_VERSION).
PYTHON_VERSION=3.14.7
YTDLP_VERSION=2026.8.19
CERTIFI_VERSION=2026.7.22
NDK_VERSION=28.2.13676358
MIN_API=24
# Floor que el motor exige en `rust/src/engine/ytdlp.rs::MIN_YTDLP_VERSION`.
# El runtime siempre debe cumplirlo; si YTDLP_VERSION < MIN, el build falla.
MIN_YTDLP_VERSION=2025.10.01
